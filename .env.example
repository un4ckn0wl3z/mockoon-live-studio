# Directory containing the Mockoon JSON file. Use forward slashes on Windows.
# Example: D:/mocks/store-api
MOCKOON_CONFIG_DIR=./data
MOCKOON_CONFIG_FILE=sample-environment.json

# Pin this in production, for example 9.6.0, instead of using latest.
MOCKOON_CLI_VERSION=latest

# Replace this before exposing either port beyond localhost.
MOCKOON_ADMIN_API_TOKEN=mockoon-local-admin-change-me

# Host port bindings. The defaults are localhost-only.
MOCKOON_BIND_ADDRESS=127.0.0.1
MOCKOON_PORT=3000
STUDIO_BIND_ADDRESS=127.0.0.1
STUDIO_PORT=4173
